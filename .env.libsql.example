# Remote libSQL data plane. Use libsql-replica only when a local read replica is needed.
MEKKA_DATA_ENGINE=libsql-remote
MEKKA_LIBSQL_URL=https://libsql.example.com
MEKKA_LIBSQL_TOKEN_ENV=MEKKA_LIBSQL_TOKEN
MEKKA_LIBSQL_TOKEN=
MEKKA_LIBSQL_REQUEST_TIMEOUT_MS=10000

# Optional embedded read replica configuration.
# MEKKA_LIBSQL_REPLICA_PATH=.local/libsql-replica.db
# MEKKA_LIBSQL_REPLICA_FALLBACK=safe-error
# MEKKA_LIBSQL_REPLICA_SYNC_INTERVAL_MS=30000

# Turso Cloud previews are intentionally unavailable in the self-hosted profile.
# Configure all four variables only in a separate Turso-backed deployment.
# MEKKA_TURSO_ORGANIZATION=
# MEKKA_TURSO_GROUP=
# MEKKA_TURSO_SOURCE_DATABASE=
# MEKKA_TURSO_API_TOKEN=
# MEKKA_TURSO_REQUEST_TIMEOUT_MS=10000
