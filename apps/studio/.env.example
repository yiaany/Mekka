NEXT_PUBLIC_SITE_URL=http://127.0.0.1:8082
MEKKA_PUBLIC_URL=http://127.0.0.1:8000
NEXT_PUBLIC_MEKKA_GATEWAY_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DOCS_URL=/docs
DEFAULT_ORGANIZATION_NAME=Local Organization
DEFAULT_PROJECT_NAME=Local Project

# Local Studio starts the loopback-only sqlite-meta service automatically in TanStack dev mode.
# Do not place provider credentials here.
STUDIO_BACKEND_API_URL=http://127.0.0.1:3001
SQLITE_META_PORT=3001
SQLITE_META_DATA_DIRECTORY=.local/sqlite-meta
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:8082

# Required by the production server. Use a random value with at least 24 characters.
# The browser authenticates with HTTP Basic Auth (any username, this value as the password).
MEKKA_STUDIO_ACCESS_TOKEN=replace-with-a-random-production-token
# Optional. Production derives a stable session secret from the Studio access token when omitted.
MEKKA_AUTH_SESSION_SECRET=replace-with-a-random-auth-session-secret

# Production email verification delivery. Keep the API key server-side.
MEKKA_RESEND_API_KEY=re_replace_with_a_server_side_key
MEKKA_AUTH_EMAIL_FROM=Mekka <auth@example.com>
# Optional test/self-hosted compatible endpoint. Production defaults to Resend's email API.
# MEKKA_RESEND_API_URL=http://127.0.0.1:9000/emails

# Public routing identity, never credentials. The backend binds it to the authenticated session.
NEXT_PUBLIC_STUDIO_ORGANIZATION_ID=org-local
NEXT_PUBLIC_STUDIO_ENVIRONMENT_ID=env-local
NEXT_PUBLIC_STUDIO_BRANCH_ID=branch-main
NEXT_PUBLIC_STUDIO_GENERATION=1

# Inject authentication and gateway credentials through the runtime secret store.
