{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!bun.lock",
      "!apps/studio",
      "!packages/ai-commands",
      "!packages/api-types",
      "!packages/build-icons",
      "!packages/common",
      "!packages/config",
      "!packages/dev-tools",
      "!packages/eslint-config-supabase",
      "!packages/icons",
      "!packages/pg-meta",
      "!packages/shared-data",
      "!packages/tsconfig",
      "!packages/ui",
      "!packages/ui-patterns"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
