{
  "name": "mekka",
  "version": "0.1.0",
  "private": true,
  "license": "LicenseRef-Mekka-Business-2.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:studio",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --build --pretty false",
    "repo:check": "node scripts/workspace-tests.mjs --check",
    "test": "node scripts/workspace-tests.mjs --bun",
    "test:workspaces": "node scripts/workspace-tests.mjs --workspaces",
    "test:supabase-data": "bun test apps/gateway/test/supabase-data-compat.test.ts",
    "build:core": "tsc --build --pretty false",
    "build": "bun run build:core && bun run build:studio",
    "dev:health": "bun --watch apps/health-service/src/index.ts",
    "start:health": "bun apps/health-service/src/index.ts",
    "smoke:health": "bun apps/health-service/src/smoke.ts",
    "dev:studio": "bun run --cwd apps/studio dev",
    "start:studio": "bun run --cwd apps/studio start",
    "smoke:studio:production": "bun run --cwd apps/studio smoke:production",
    "lint:studio": "bun run --cwd apps/studio lint",
    "typecheck:studio": "bun run --cwd apps/studio typecheck",
    "build:studio": "bun run --cwd apps/studio build",
    "test:studio:fork": "bun run --cwd apps/studio test:fork",
    "check": "bun run repo:check && bun run format:check && bun run lint && bun run typecheck && bun run typecheck:studio && bun run test && bun run test:workspaces && bun run test:studio:fork && bun run build && bun run smoke:studio:production && bun run smoke:health"
  },
  "catalog": {
    "@monaco-editor/react": "4.7.0",
    "@sentry/nextjs": "10.59.0",
    "@sentry/tanstackstart-react": "10.59.0",
    "@supabase/auth-js": "2.110.9",
    "@supabase/postgrest-js": "2.110.9",
    "@supabase/realtime-js": "2.110.9",
    "@supabase/ssr": "0.10.2",
    "@supabase/supabase-js": "2.110.9",
    "@tanstack/react-router": "1.170.10",
    "@tanstack/react-start": "1.168.18",
    "@tanstack/react-table": "8.21.3",
    "@types/node": "22.13.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.4",
    "@vitest/ui": "4.1.4",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "monaco-editor": "0.52.2",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "postcss": "8.5.25",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "2.15.4",
    "tailwindcss": "4.2.4",
    "tsx": "4.22.4",
    "typescript": "~6.0.2",
    "valtio": "2.3.2",
    "vite": "8.0.16",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.4",
    "zod": "3.25.76"
  },
  "overrides": {
    "@ai-sdk/amazon-bedrock": "4.0.81",
    "@ai-sdk/mcp": "1.0.25",
    "@ai-sdk/openai": "3.0.41",
    "@ai-sdk/provider": "3.0.8",
    "@ai-sdk/provider-utils": "4.0.19",
    "@ai-sdk/react": "3.0.118",
    "@sentry/browser": "10.59.0",
    "@sentry/core": "10.59.0",
    "@sentry/react": "10.59.0",
    "@types/papaparse": "5.3.9",
    "@usercentrics/cmp-browser-sdk": "4.42.0",
    "ai": "6.0.174",
    "lucide-react": "0.436.0",
    "js-yaml": "4.3.1",
    "mermaid": "11.16.1",
    "lodash": "4.18.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "1.5.0",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "bun-types": "1.3.14",
    "jsdom": "30.0.1",
    "typescript": "5.9.3"
  }
}
