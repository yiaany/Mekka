{
  "name": "@mekka/storage-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "default": "./dist/sqlite.js"
    },
    "./s3": {
      "types": "./dist/s3-object-provider.d.ts",
      "default": "./dist/s3-object-provider.js"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1023.0",
    "@mekka/protocol": "workspace:*"
  }
}
